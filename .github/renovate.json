{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "timezone": "Europe/Istanbul",
  "semanticCommits": "enabled",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "osvVulnerabilityAlerts": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(deps):",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 5am on monday"]
  },
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["overrides", "pnpm-workspace.overrides"],
      "rebaseWhen": "conflicted",
      "automerge": false
    },
    {
      "matchDepTypes": ["dependencies"],
      "automerge": false,
      "rebaseWhen": "conflicted"
    },
    {
      "matchPackageNames": ["eslint", "@eslint/js", "/^typescript-eslint/"],
      "groupName": "eslint toolchain",
      "commitMessageTopic": "eslint-toolchain"
    },
    {
      "matchPackageNames": ["typescript", "tsx", "vitest", "vitepress"],
      "groupName": "toolchain dependencies",
      "commitMessageTopic": "toolchain"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["fast-check", "prettier", "globals"],
      "groupName": "development utility dependencies",
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions dependencies",
      "commitMessageTopic": "github-actions",
      "commitMessagePrefix": "ci(deps):",
      "automerge": false,
      "rebaseWhen": "conflicted"
    },
    {
      "description": "The pnpm version is a repository-wide runtime contract, not an isolated Actions update",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["pnpm"],
      "enabled": false
    },
    {
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hook dependencies",
      "commitMessageTopic": "pre-commit-hooks",
      "commitMessagePrefix": "chore(deps):",
      "automerge": false,
      "rebaseWhen": "conflicted"
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "rebaseWhen": "never",
      "recreateWhen": "never",
      "automerge": false
    },
    {
      "matchPackageNames": ["node", "pnpm"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "rebaseWhen": "never",
      "recreateWhen": "never"
    },
    {
      "description": "Automerge pnpm-workspace override patches only after required checks pass; repair pnpm lockfile peers after updates",
      "matchManagers": ["npm"],
      "matchDepTypes": ["pnpm-workspace.overrides"],
      "matchUpdateTypes": ["patch"],
      "postUpdateOptions": ["pnpmDedupe"],
      "automerge": true
    },
    {
      "description": "Regenerate hashed pre-commit Python requirements via pip-compile; require reviewed PR and passing OSV, CI and pip hash installation",
      "matchManagers": ["pip-compile"],
      "automerge": false,
      "rebaseWhen": "conflicted"
    }
  ],
  "pip-compile": {
    "managerFilePatterns": ["/^\\.github\\/requirements\\/pre-commit\\.txt$/"],
    "lockFileMaintenance": {
      "enabled": true,
      "automerge": false
    }
  }
}
