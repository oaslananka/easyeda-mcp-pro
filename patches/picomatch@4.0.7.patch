+// A leading bare */? quantifier inside repeated extglobs can backtrack
+// exponentially (CVE-2026-112366). The upstream draft guards +(*a),
+// but bare-only bodies also fail with a suffix: +(*)z, +(*?)z.
+// Literalize such branches. Preserve nested extglob openers and literal
+// prefixes, which already have their own matching guards.
+const hasUnsafeLeadingQuantifier = branch => {
+  let i = 0;
+
+  while (i < branch.length && (branch[i] === '*' || branch[i] === '?') && branch[i + 1] !== '(') {
+    i++;
+  }
+
+  // Includes bare-only branches because a suffix may follow the extglob.
+  return i > 0;
+};
