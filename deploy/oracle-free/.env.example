# Only non-secret settings; secrets remain in Doppler.
# Fill with a verified immutable GHCR digest after Hosted Cloud is accepted.
# Stable v1.15.5 does NOT contain the Draft Hosted Cloud feature.
# Do NOT use v1.15.5 as the Hosted Cloud production image.
EASYEDA_IMAGE=
EASYEDA_PUBLIC_ORIGIN=https://easyeda-mcp-pro.oaslananka.dev
EASYEDA_HOST_PORT=13000
# Default 8 MiB frame cap; binary artifacts use at most 60% of this.
EASYEDA_BRIDGE_MAX_PAYLOAD_SIZE=8388608

# Optional: leave empty until the trusted ingress boundary is verified.
CLOUD_TRUSTED_PROXY_IP=
