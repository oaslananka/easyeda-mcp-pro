{
  "name": "@easyeda-mcp-pro/bridge-extension",
  "version": "0.0.0-private",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/package.mjs",
    "build:dev": "MCP_DEV_HOTSWAP=true node scripts/build.mjs && node scripts/package.mjs",
    "build:watch": "node scripts/dev-watch.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "verify": "node scripts/verify-dist.mjs"
  },
  "devDependencies": {
    "archiver": "^8.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
