{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "timezone": "Europe/Istanbul",
  "semanticCommits": "enabled",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "osvVulnerabilityAlerts": true,
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(deps):",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 5am on monday"]
  },
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["overrides"],
      "rebaseWhen": "conflicted",
      "automerge": false
    },
    {
      "matchDepTypes": ["dependencies"],
      "automerge": false,
      "rebaseWhen": "conflicted"
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "rebaseWhen": "conflicted"
    },
    {
      "matchPackageNames": ["eslint", "@eslint/js", "/^typescript-eslint/"],
      "groupName": "eslint toolchain",
      "commitMessageTopic": "eslint-toolchain"
    },
    {
      "matchPackageNames": ["typescript", "tsx", "vitest", "vitepress"],
      "groupName": "toolchain dependencies",
      "commitMessageTopic": "toolchain"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["fast-check", "prettier", "globals"],
      "groupName": "development utility dependencies",
      "automerge": true
    },
    {
      "matchPackageNames": ["node", "pnpm"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "rebaseWhen": "conflicted"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions dependencies",
      "commitMessageTopic": "github-actions",
      "commitMessagePrefix": "ci(deps):",
      "automerge": false,
      "rebaseWhen": "conflicted"
    },
    {
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hook dependencies",
      "commitMessageTopic": "pre-commit-hooks",
      "commitMessagePrefix": "chore(deps):",
      "automerge": false,
      "rebaseWhen": "conflicted"
    }
  ]
}
